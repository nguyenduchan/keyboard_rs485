*.lck
~*.lck
*.kicad_prl
fp-info-cache
*-backups/
*.kicad_pcb-bak
*.kicad_sch-bak
_autosave-*
*.tmp

# Plot / preview exports
hardware/kicad/panel-keyboard/tools/_preview/

