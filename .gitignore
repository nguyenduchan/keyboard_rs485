hardware/kicad/panel-keyboard/tools/_scan_nets.py
hardware/kicad/panel-keyboard/tools/_dump_u1_pins.py

# Python
__pycache__/
*.pyc

# Editor
.vs/
*.swp
**/.history/

# Firmware build output
firmware/build/

# OS
Thumbs.db
desktop.ini
.DS_Store

# Firmware / C build artifacts (ngoài firmware/build/)
*.o
*.obj
*.elf
*.map
*.lst
tests/build/

# .NET (pcapp): đã có trong pcapp/.gitignore, thêm các thứ hay sinh ra
TestResults/
publish/
*.nupkg

# Claude Code local state (cài đặt riêng từng máy)
.claude/settings.local.json
