(footprint "LED_3mm_THT"
  (version 20241229)
  (generator "panel-keyboard")
  (descr "3 mm LED through-hole, panel front")
  (tags "LED 3mm tht")
  (attr through_hole)
  (fp_text reference "D**" (at 0 -3.5 0) (layer "F.SilkS") (effects (font (size 0.9 0.9) (thickness 0.12))))
  (fp_text value "LED_3mm" (at 0 3.5 0) (layer "F.Fab") (effects (font (size 0.7 0.7) (thickness 0.1)) hide))
  (fp_circle (center 0 0) (end 1.6 0) (stroke (width 0.12) (type default)) (layer "F.Fab"))
  (fp_line (start -1.8 0) (end -1.2 0) (stroke (width 0.12) (type default)) (layer "F.SilkS"))
  (pad "1" thru_hole circle (at -1.27 0) (size 1.8 1.8) (drill 0.9) (layers "*.Cu" "*.Mask"))
  (pad "2" thru_hole circle (at 1.27 0) (size 1.8 1.8) (drill 0.9) (layers "*.Cu" "*.Mask"))
  (model "${KICAD10_3DMODEL_DIR}/LED_THT.3dshapes/LED_D3.0mm.step" (offset (xyz -1.27 0 0)) (scale (xyz 1 1 1)) (rotate (xyz 0 0 0)))
)
