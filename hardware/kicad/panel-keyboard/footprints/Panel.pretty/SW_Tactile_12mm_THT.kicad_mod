(footprint "SW_Tactile_12mm_THT"
  (version 20241229)
  (generator "panel-keyboard")
  (descr "12 mm tactile through-hole, 4 pin, Omron B3F-4055 / generic 12x12x7.3, chân 12,5 dọc theo Y; 1-4 cùng cực (x=-2,5), 2-3 cùng cực (x=+2,5); 2 lỗ định vị Ø1,7, actuator to F.Cu")
  (tags "switch tact 12mm tht")
  (attr through_hole)
  (fp_text reference "SW" (at 0 -9 0) (layer "F.SilkS") (effects (font (size 1 1) (thickness 0.15))))
  (fp_text value "Tact_12mm_THT" (at 0 9 0) (layer "F.Fab") (effects (font (size 1 1) (thickness 0.15)) hide))
  (fp_circle (center 0 0) (end 6 0) (stroke (width 0.12) (type default)) (layer "F.Fab"))
  (fp_line (start -6.6 -7.6) (end 6.6 -7.6) (stroke (width 0.12) (type default)) (layer "F.CrtYd"))
  (fp_line (start 6.6 -7.6) (end 6.6 7.6) (stroke (width 0.12) (type default)) (layer "F.CrtYd"))
  (fp_line (start 6.6 7.6) (end -6.6 7.6) (stroke (width 0.12) (type default)) (layer "F.CrtYd"))
  (fp_line (start -6.6 7.6) (end -6.6 -7.6) (stroke (width 0.12) (type default)) (layer "F.CrtYd"))
  (pad "1" thru_hole circle (at -2.5 -6.25) (size 2.2 2.2) (drill 1.3) (layers "*.Cu" "*.Mask"))
  (pad "2" thru_hole circle (at 2.5 -6.25) (size 2.2 2.2) (drill 1.3) (layers "*.Cu" "*.Mask"))
  (pad "3" thru_hole circle (at 2.5 6.25) (size 2.2 2.2) (drill 1.3) (layers "*.Cu" "*.Mask"))
  (pad "4" thru_hole circle (at -2.5 6.25) (size 2.2 2.2) (drill 1.3) (layers "*.Cu" "*.Mask"))
  (pad "" np_thru_hole circle (at -4.5 0) (size 1.7 1.7) (drill 1.7) (layers "*.Cu" "*.Mask"))
  (pad "" np_thru_hole circle (at 4.5 0) (size 1.7 1.7) (drill 1.7) (layers "*.Cu" "*.Mask"))
  (model "${KIPRJMOD}/3d/SW_B3F4055_A14.wrl" (offset (xyz 0 0 0)) (scale (xyz 1 1 1)) (rotate (xyz 0 0 0)))
)
