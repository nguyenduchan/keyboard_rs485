(footprint "TerminalBlock_2P_5.08"
  (version 20241229)
  (generator "panel-keyboard")
  (descr "2P 5.08 mm pluggable terminal, bottom edge")
  (tags "terminal 5.08")
  (attr through_hole)
  (fp_text reference "J_PWR" (at 0 -4 0) (layer "B.SilkS") (effects (font (size 1 1) (thickness 0.15))))
  (fp_text value "KF301-5.08-2P" (at 0 4 0) (layer "B.Fab") (effects (font (size 1 1) (thickness 0.15)) hide))
  (fp_line (start -6 -3) (end 6 -3) (stroke (width 0.12) (type default)) (layer "B.Fab"))
  (fp_line (start -6 3) (end 6 3) (stroke (width 0.12) (type default)) (layer "B.Fab"))
  (pad "1" thru_hole rect (at -2.54 0) (size 2.4 2.4) (drill 1.3) (layers "*.Cu" "*.Mask"))
  (pad "2" thru_hole rect (at 2.54 0) (size 2.4 2.4) (drill 1.3) (layers "*.Cu" "*.Mask"))
  (model "${KICAD10_3DMODEL_DIR}/TerminalBlock_Phoenix.3dshapes/TerminalBlock_Phoenix_MKDS-1,5-2-5.08_1x02_P5.08mm_Horizontal.step" (offset (xyz 2.54 0 0)) (scale (xyz 1 1 1)) (rotate (xyz 0 0 180)))
)
