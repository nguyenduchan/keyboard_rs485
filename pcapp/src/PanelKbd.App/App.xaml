<Application x:Class="PanelKbd.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <FontFamily x:Key="UiFont">Segoe UI</FontFamily>
        <Style TargetType="Window"><Setter Property="FontFamily" Value="{StaticResource UiFont}"/><Setter Property="FontSize" Value="13"/></Style>
        <Style TargetType="TextBox"><Setter Property="Padding" Value="4,3"/><Setter Property="Margin" Value="0,0,0,8"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
        <Style TargetType="ComboBox"><Setter Property="Padding" Value="4,3"/><Setter Property="Margin" Value="0,0,0,8"/></Style>
        <Style TargetType="CheckBox"><Setter Property="Margin" Value="0,2,0,8"/></Style>
        <Style x:Key="Cap" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#666"/><Setter Property="FontSize" Value="11.5"/><Setter Property="Margin" Value="0,0,0,2"/>
        </Style>
        <Style x:Key="Tool" TargetType="Button">
            <Setter Property="Padding" Value="10,4"/><Setter Property="Margin" Value="2,0"/>
        </Style>
    </Application.Resources>
</Application>
